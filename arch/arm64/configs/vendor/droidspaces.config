# Droidspaces container support, following the upstream "GKI" option list
# (Documentation/Kernel-Configuration.md in ravindu644/Droidspaces-OSS).
# Stay within that list: the prebuilt vendor modules pin the kernel ABI, and
# options such as CGROUP_DEVICE or CGROUP_PIDS change it.

# IPC. SYSVIPC and POSIX_MQUEUE add fields to task_struct and user_struct;
# include/linux/sched.h and include/linux/sched/user.h place those in
# ANDROID_KABI padding so no offset moves.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# /dev for containers with hardware access
CONFIG_DEVTMPFS=y

# NAT mode
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# UFW inside containers. The REJECT targets are already enabled in the
# official config (IP_NF_TARGET_REJECT, IP6_NF_TARGET_REJECT).
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban inside containers
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# xattr and POSIX ACLs on tmpfs (NixOS)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Left off: user namespaces. Upstream lists CONFIG_USER_NS=y as optional (it
# silences Docker's "unsafe procfs" error), but it also lets every unprivileged
# Android app create user namespaces, which Android kernels keep disabled to
# limit kernel attack surface. It is ABI-compatible; enable it here if you
# need Docker inside a container.
# CONFIG_USER_NS=y
