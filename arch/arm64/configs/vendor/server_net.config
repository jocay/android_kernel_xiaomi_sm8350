# Network stack choices for running the phone as an always-on server.
# Runtime knobs: net.ipv4.tcp_congestion_control, net.core.default_qdisc.

# BBR as the default TCP congestion control (cubic stays available).
# TCP_CONG_ADVANCED defaults a few other algorithms to =m; keep them off.
CONFIG_TCP_CONG_ADVANCED=y
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y

# fq_codel as the default qdisc instead of pfifo_fast: keeps queueing delay
# low under load, including for traffic forwarded from containers. fq is
# built too for those who prefer it with BBR.
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
